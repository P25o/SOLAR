# ============================================================
# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ตอนรันในเครื่องตัวเอง)
# บน Render ให้ใส่ค่าเดียวกันนี้ในหน้า Environment แทน
#
# ⚠️ ห้ามอัปไฟล์ .env ตัวจริงขึ้น GitHub เด็ดขาด
# ============================================================

# --- Stripe ---
# Dashboard > Developers > API keys > Secret key
# โหมดทดสอบขึ้นต้นด้วย sk_test_
STRIPE_SECRET_KEY=sk_test_ใส่ค่าจริงตรงนี้

# Dashboard > Developers > Webhooks > (endpoint ที่สร้าง) > Signing secret
# ขึ้นต้นด้วย whsec_
STRIPE_WEBHOOK_SECRET=whsec_ใส่ค่าจริงตรงนี้

# --- Firebase ---
FIREBASE_DB_URL=https://solar-station-5b0a8-default-rtdb.asia-southeast1.firebasedatabase.app

# ไม่ต้องใส่ก็ได้ ใส่เมื่อล็อก Firebase Rules แล้วเท่านั้น
# (Project settings > Service accounts > Database secrets)
FIREBASE_DB_SECRET=

# --- หน้าเว็บของลูกค้า ---
# URL เต็มของ pay.html ที่อยู่บน GitHub Pages
# Stripe จะเด้งลูกค้ากลับมาที่นี่หลังจ่ายเสร็จ
PUBLIC_WEB_URL=https://ชื่อผู้ใช้.github.io/ชื่อ-repo/pay.html

# --- สถานี ---
DEFAULT_STATION_ID=station_01

# --- โหมดสาธิต ---
# true  = แปลงนาทีเป็นวินาที (10 บาท = 15 วินาที) ใช้ตอนโชว์กรรมการ
# false = เวลาจริง
DEMO_MODE=true
